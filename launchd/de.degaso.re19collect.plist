<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>de.degaso.re19collect</string>
  <key>ProgramArguments</key>
  <array><string>__INSTALL_DIR__/run.sh</string><string>--collect</string></array>
  <!-- alle 5 min, solange der Mac wach ist -->
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>__INSTALL_DIR__/re19collect.log</string>
  <key>StandardErrorPath</key><string>__INSTALL_DIR__/re19collect.log</string>
</dict>
</plist>
